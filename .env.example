# ListingPilot AI configuration. Copy to .env.local and fill in.
# Every variable is optional except APP_SECRET in production.

# Required in production: 32+ random characters. Encrypts customer API keys stored in cookies.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# --- Provider keys (optional) -------------------------------------------------
# Server-wide keys. If set, customers without their own key use these, and
# YOU are billed. Leave empty to require customers to bring their own key.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
# Any API implementing OpenAI Chat Completions with JSON-schema output.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model ID pre-filled for the OpenAI-compatible provider.
OPENAI_DEFAULT_MODEL=

# Let customers store their own key (encrypted, httpOnly cookie). Default true.
ALLOW_USER_KEYS=true
# Free template-based demo provider (no AI calls). Default true.
ENABLE_DEMO_PROVIDER=true

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_BATCH_SIZE=10
MAX_PRODUCTS_PER_JOB=500
GENERATION_CONCURRENCY=3
RATE_LIMIT_PER_MINUTE=20
MAX_OUTPUT_TOKENS=16000

# Prices (USD per 1M tokens) for cost estimates, keyed "provider:model".
# Built-in prices exist for the listed Claude models; add others here.
# MODEL_PRICING_JSON={"openai:your-model-id":{"inputPerMTok":1.25,"outputPerMTok":10}}
MODEL_PRICING_JSON=

# --- Storage ------------------------------------------------------------------
# Neon Postgres connection string (Neon console > Connect). When set, saved
# workspaces go to Neon and STORAGE_DRIVER defaults to "neon".
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# neon:   Neon Postgres via DATABASE_URL (default when DATABASE_URL is set)
# none:   workspaces are saved in the customer's browser (default otherwise)
# file:   JSON files on the server under STORAGE_DIR (single-server deployments)
# memory: server memory, lost on restart (testing)
STORAGE_DRIVER=
# Create the workspaces table automatically on first use. Set false if you
# run `npm run db:migrate` as part of deployment instead.
STORAGE_AUTO_MIGRATE=true
STORAGE_DIR=.data/workspaces
